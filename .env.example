# Shared PostgreSQL database (same DATABASE_URL as mlb-predictor / nba-predictor)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mlb_predictor

# Set to false to run without a database (predictions still generated, not persisted)
ENABLE_DB_PERSISTENCE=true
ENABLE_FALLBACK_MODE=true

# NHL automation API port (default: 8790)
NHL_API_PORT=8790

# Directory where exported CSVs are written
NHL_EXPORT_DIR=./generated/nhl

# ─── Playwright odds capture ──────────────────────────────────────────────────
# Required for nhl:capture-odds-overrides; not needed if using manual file import

ODDS_CAPTURE_LOGIN_URL=
ODDS_CAPTURE_PAGE_URL=           # navigate here after login if different from login URL
ODDS_CAPTURE_USERNAME=
ODDS_CAPTURE_PASSWORD=

# CSS or XPath selectors (XPath must start with // or ()
ODDS_CAPTURE_USERNAME_SELECTOR=
ODDS_CAPTURE_PASSWORD_SELECTOR=
ODDS_CAPTURE_SUBMIT_SELECTOR=
ODDS_CAPTURE_CONTENT_SELECTOR=   # outermost element whose innerText contains all odds rows

# Optional selectors
ODDS_CAPTURE_SUCCESS_SELECTOR=   # element that confirms successful login
ODDS_CAPTURE_MODAL_CLOSE_SELECTOR=
ODDS_CAPTURE_LOGIN_FRAME_SELECTOR=

# Pipe-separated (||) list of nav selectors to click after login to reach NHL odds page
ODDS_CAPTURE_NAV_SELECTORS=

# Label stored on imported rows (e.g. "betlotus-nhl")
ODDS_CAPTURE_PROVIDER=betlotus-nhl

# Timing / browser
ODDS_CAPTURE_HEADLESS=true
ODDS_CAPTURE_TIMEOUT_MS=45000
ODDS_CAPTURE_STEP_DELAY_MS=1000
ODDS_CAPTURE_TYPE_DELAY_MS=75
ODDS_CAPTURE_BROWSER_CHANNEL=    # e.g. "chrome" to use installed Chrome instead of bundled Chromium
ODDS_CAPTURE_USER_AGENT=         # leave blank to use default Chrome UA
